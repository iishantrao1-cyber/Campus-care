# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Long random string used to sign session cookies and OTP hashes
SESSION_SECRET=replace-with-a-long-random-secret

# Public base URL used in verification emails
APP_URL=https://your-campus-care.example.edu

# First admin bootstrap (only used when no admin exists yet)
ADMIN_BOOTSTRAP_EMAIL=grievance.admin@college.edu
ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-password-10plus
ADMIN_BOOTSTRAP_NAME=Campus Grievance Administrator
ADMIN_BOOTSTRAP_EMPLOYEE_ID=ADM-001

# Optional: bootstrap MFA fallback code before authenticator enrollment
# ADMIN_MFA_BOOTSTRAP_CODE=

# Optional SMTP — when unset, OTPs are stored in admin-only email outbox
# SMTP_HOST=smtp.college.edu
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Campus Care <noreply@college.edu>
# SMTP_SECURE=false

# FORCE_SECURE_COOKIES=true
